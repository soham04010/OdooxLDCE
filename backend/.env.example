PORT=5000

# Supabase connection string.
# Use the Supavisor POOLER host, not db.<ref>.supabase.co — the direct host is
# IPv6-only and fails with ENOTFOUND on networks without IPv6 connectivity.
# Find it in: Dashboard > Project Settings > Database > Connection string > Session pooler
# Note the username is postgres.<PROJECT-REF>, not plain postgres.
# URL-encode special characters in the password (@ becomes %40).
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Used to sign auth tokens. Set a long random value in production.
JWT_SECRET=
